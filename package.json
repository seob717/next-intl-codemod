{
  "name": "next-intl-codemod",
  "version": "0.1.4",
  "type": "module",
  "bin": {
    "next-intl-codemod": "dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "codemod": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@eloqnt/config": "^0.1.1",
    "@eloqnt/format-json": "^0.1.0",
    "@eloqnt/format-po": "^0.1.1",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@types/node": "^26.6.5",
    "next-intl": "^4.14.9",
    "next-intl-swc-plugin-extractor": "^4.14.9",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.3"
  },
  "description": "Migrates next-intl useTranslations/getTranslations with static keys to useExtracted/getExtracted and carries existing translations over.",
  "keywords": [
    "next-intl",
    "codemod",
    "i18n",
    "nextjs",
    "useExtracted",
    "getExtracted",
    "migration",
    "po"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seob717/next-intl-codemod.git"
  }
}
